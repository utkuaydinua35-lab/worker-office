generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum UserStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

enum MemberRole {
  ADMIN
  MODERATOR
  GUEST
}

enum ChannelType {
  TEXT
  VOICE
}

// ─── Users ──────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  // bcrypt hash — never the plain-text password.
  password     String
  avatarUrl    String?
  bio          String?    @db.VarChar(190)
  status       UserStatus @default(OFFLINE)
  customStatus String?    @db.VarChar(128)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ownedServers Server[]  @relation("ServerOwner")
  memberships  Member[]
  messages     Message[]

  // A Conversation has two fixed participants; the relation pair is split so
  // both sides can be queried ("conversations where I am userOne or userTwo").
  conversationsInitiated Conversation[]  @relation("ConversationUserOne")
  conversationsReceived  Conversation[]  @relation("ConversationUserTwo")
  directMessages         DirectMessage[]
}

// ─── Servers (guilds) ───────────────────────────────────────────────────

model Server {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(100)
  iconUrl    String?
  inviteCode String   @unique
  ownerId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner    User      @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  Member[]
  channels Channel[]

  @@index([ownerId])
}

model Member {
  id        String     @id @default(uuid())
  role      MemberRole @default(GUEST)
  userId    String
  serverId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  // A user joins a given server at most once.
  @@unique([userId, serverId])
  @@index([serverId])
}

model Channel {
  id        String      @id @default(uuid())
  name      String      @db.VarChar(100)
  type      ChannelType @default(TEXT)
  serverId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([serverId])
}

model Message {
  id        String   @id @default(uuid())
  content   String   @db.Text
  fileUrl   String?
  // Soft delete keeps the row so the chat can render "message deleted".
  deleted   Boolean  @default(false)
  userId    String
  channelId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // Cursor pagination reads a channel's messages newest-first.
  @@index([channelId, createdAt])
  @@index([userId])
}

// ─── Direct messages ────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(uuid())
  // Stored with userOneId < userTwoId (see src/lib/conversation.ts) so each
  // pair of users maps to exactly one row.
  userOneId String
  userTwoId String
  createdAt DateTime @default(now())

  userOne        User            @relation("ConversationUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo        User            @relation("ConversationUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  directMessages DirectMessage[]

  @@unique([userOneId, userTwoId])
  @@index([userTwoId])
}

model DirectMessage {
  id             String   @id @default(uuid())
  content        String   @db.Text
  fileUrl        String?
  deleted        Boolean  @default(false)
  userId         String
  conversationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
}
