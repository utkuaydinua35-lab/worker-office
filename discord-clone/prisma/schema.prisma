generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum UserStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

enum MemberRole {
  ADMIN
  MODERATOR
  GUEST
}

enum ChannelType {
  TEXT
  VOICE
}

// ─── Users ──────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  // bcrypt hash — never the plain-text password.
  password     String
  avatarUrl    String?
  bio          String?    @db.VarChar(190)
  status       UserStatus @default(OFFLINE)
  customStatus String?    @db.VarChar(128)
  // System accounts (the music bot). They can't sign in and own no memberships.
  isBot        Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ownedServers    Server[]         @relation("ServerOwner")
  memberships     Member[]
  messages        Message[]
  reactions       Reaction[]
  directReactions DirectReaction[]
  channelReads    ChannelRead[]

  // A Conversation has two fixed participants; the relation pair is split so
  // both sides can be queried ("conversations where I am userOne or userTwo").
  conversationsInitiated Conversation[]  @relation("ConversationUserOne")
  conversationsReceived  Conversation[]  @relation("ConversationUserTwo")
  directMessages         DirectMessage[]
}

// ─── Servers (guilds) ───────────────────────────────────────────────────

model Server {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(100)
  iconUrl    String?
  inviteCode String   @unique
  ownerId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner    User      @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  Member[]
  channels Channel[]

  @@index([ownerId])
}

model Member {
  id             String     @id @default(uuid())
  role           MemberRole @default(GUEST)
  // Server mute (Discord's): set by a moderator, applies to every voice
  // channel of the server and survives leaving and rejoining.
  serverMuted    Boolean    @default(false)
  // Server deafen: can't hear anyone in the server's voice channels. Same lifetime as serverMuted.
  serverDeafened Boolean    @default(false)
  userId         String
  serverId       String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  // A user joins a given server at most once.
  @@unique([userId, serverId])
  @@index([serverId])
}

model Channel {
  id        String      @id @default(uuid())
  name      String      @db.VarChar(100)
  type      ChannelType @default(TEXT)
  serverId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  server   Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages Message[]
  reads    ChannelRead[]

  @@index([serverId])
}

// How far each member has read a text channel (unread markers, mention badges).
model ChannelRead {
  userId     String
  channelId  String
  lastReadAt DateTime

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
}

model Message {
  id        String   @id @default(uuid())
  content   String   @db.Text
  fileUrl   String?
  // Soft delete keeps the row so the chat can render "message deleted".
  deleted   Boolean  @default(false)
  pinned    Boolean  @default(false)
  // Ids of the members this message @mentions, resolved when it was sent.
  mentions  String[] @default([])
  replyToId String?
  userId    String
  channelId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  replyTo   Message?   @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]  @relation("MessageReplies")
  reactions Reaction[]

  // Cursor pagination reads a channel's messages newest-first.
  @@index([channelId, createdAt])
  @@index([channelId, pinned])
  @@index([userId])
}

model Reaction {
  id        String   @id @default(uuid())
  emoji     String   @db.VarChar(64)
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

// ─── Direct messages ────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(uuid())
  // Stored with userOneId < userTwoId (see src/lib/conversation.ts) so each
  // pair of users maps to exactly one row.
  userOneId String
  userTwoId String
  createdAt DateTime @default(now())

  userOne        User            @relation("ConversationUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo        User            @relation("ConversationUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  directMessages DirectMessage[]

  @@unique([userOneId, userTwoId])
  @@index([userTwoId])
}

model DirectMessage {
  id             String   @id @default(uuid())
  content        String   @db.Text
  fileUrl        String?
  deleted        Boolean  @default(false)
  pinned         Boolean  @default(false)
  replyToId      String?
  userId         String
  conversationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo      DirectMessage?   @relation("DirectMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      DirectMessage[]  @relation("DirectMessageReplies")
  reactions    DirectReaction[]

  @@index([conversationId, createdAt])
  @@index([conversationId, pinned])
  @@index([userId])
}

model DirectReaction {
  id              String   @id @default(uuid())
  emoji           String   @db.VarChar(64)
  userId          String
  directMessageId String
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  directMessage DirectMessage @relation(fields: [directMessageId], references: [id], onDelete: Cascade)

  @@unique([directMessageId, userId, emoji])
}
