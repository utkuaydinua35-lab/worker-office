# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/discord_clone?schema=public"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me"

# Optional — Cloudinary storage for avatars, server icons and attachments.
# Leave empty to store files on local disk under uploads/.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# LiveKit (voice/video). Local: `livekit-server --dev` → ws://localhost:7880, devkey / secret.
# LiveKit Cloud: project URL (wss://...livekit.cloud) and an API key pair from the dashboard.
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# Music bot (stage 5). Needs yt-dlp and ffmpeg on the server: brew install yt-dlp ffmpeg
# Override the binaries if they're not on PATH:
YTDLP_PATH=""
FFMPEG_PATH=""
# !play accepts YouTube links and searches only. Extra hosts (comma-separated) widen that;
# the server downloads whatever these point at, so only list hosts you trust.
MUSIC_EXTRA_URL_HOSTS=""

# Invite-only sign-up: only people who know this code can register. Empty = open.
REGISTRATION_CODE=""

# Production only (deploy/docker-compose.yml sets these):
# BIND_HOST=127.0.0.1                      keep the app port off the network
# LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880 how the server reaches LiveKit directly
