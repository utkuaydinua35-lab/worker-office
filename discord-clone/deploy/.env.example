# Copy to deploy/.env and fill in. Never commit deploy/.env.
# Generate each secret with:  openssl rand -base64 32 | tr -d '/+='

DOMAIN=hasbihal.bernzcompany.com

NEXTAUTH_SECRET=
POSTGRES_PASSWORD=

# LiveKit API key pair: any id-like key and a long random secret.
LIVEKIT_API_KEY=hasbihal
LIVEKIT_API_SECRET=

# Invite-only sign-up: share this with your friends. Leave empty for open sign-up.
REGISTRATION_CODE=

# Cloudflare Tunnel setup only (docker-compose.tunnel.yml): LiveKit Cloud's
# project URL; LIVEKIT_API_KEY / LIVEKIT_API_SECRET above are that project's keys.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# Host port the tunnel points at (127.0.0.1 only). Change if 3000 is taken.
# APP_PORT=3000
