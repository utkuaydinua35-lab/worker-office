# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/discord_clone?schema=public"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me"

# Optional — Cloudinary storage for avatars, server icons and attachments.
# Leave empty to store files on local disk under uploads/.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# LiveKit (voice/video). Local: `livekit-server --dev` → ws://localhost:7880, devkey / secret.
# LiveKit Cloud: project URL (wss://...livekit.cloud) and an API key pair from the dashboard.
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
